{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "atelier-mira/series-showcase",
  "version": "1.0.0",
  "title": "Artwork Series Showcase",
  "category": "widgets",
  "icon": "art",
  "description": "Presents artwork series, each with its description and a row of its latest works.",
  "keywords": [
    "portfolio",
    "series",
    "artwork",
    "gallery"
  ],
  "textdomain": "atelier-mira",
  "attributes": {
    "heading": {
      "type": "string",
      "default": "Three series, painted in parallel"
    },
    "series": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "default": []
    },
    "worksPerSeries": {
      "type": "integer",
      "default": 3
    },
    "showDescription": {
      "type": "boolean",
      "default": true
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true
    }
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}